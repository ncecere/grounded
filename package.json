{
  "name": "grounded",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @grounded/api dev",
    "dev:web": "bun run --filter @grounded/web dev",
    "dev:ingestion": "bun run --filter @grounded/ingestion-worker dev",
    "dev:scraper": "bun run --filter @grounded/scraper-worker dev",
    "build": "bun run --filter '*' build",
    "lint": "oxlint .",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @grounded/db generate",
    "db:migrate": "bun run --filter @grounded/db migrate",
    "db:push": "bun run --filter @grounded/db push",
    "db:studio": "bun run --filter @grounded/db studio",
    "typecheck": "bun run --filter '*' typecheck",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "oxlint": "1.43.0",
    "shadcn": "3.8.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "hono": "^4.11.8",
    "fast-xml-parser": "^5.3.4",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@isaacs/brace-expansion": "^5.0.1",
    "lodash-es": "^4.17.23",
    "diff": "^8.0.3"
  }
}
