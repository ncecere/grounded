        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(grounded_build_info, namespace)",
        "query": {
          "query": "label_values(grounded_build_info, namespace)",
          "refId": "namespace",
          "qryType": 1
        },
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
