# grounded-config: non-secret settings (docs/deployments/kubernetes.md,
# "Configuration"). Every setting is described in .env.example. Values are
# literal (no quotes). Overlays merge their own keys into grounded-config.
#
# The public origin users reach Grounded at. Placeholder: overlays set it.
APP_URL=https://grounded.example.org
HTTP_ADDR=:8080
WORKER_HTTP_ADDR=:9090
# /metrics (with /healthz and /readyz) on an internal api listener, off the
# port the Ingress serves (docs/operations/monitoring.md).
METRICS_ADDR=:9091
LOG_FORMAT=json
LOG_LEVEL=info
DEV_AUTH=false
# Object storage. Placeholders: overlays set the endpoint and bucket.
BLOB_BACKEND=s3
S3_ENDPOINT=https://s3.example.org
S3_BUCKET=grounded
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Graceful shutdown: readiness fails, SHUTDOWN_DELAY lets load balancers
# notice, then in-flight requests (SSE chats) and jobs get SHUTDOWN_TIMEOUT.
# Keep terminationGracePeriodSeconds (120s) above SHUTDOWN_DELAY +
# SHUTDOWN_TIMEOUT + 10s; raise them together.
SHUTDOWN_DELAY=10s
SHUTDOWN_TIMEOUT=90s
