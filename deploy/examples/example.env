# Example deployment settings (ADR-0018, ADR-0023): the settings that give a
# Grounded install its identity. Copy this file into the install's own
# (private) configuration and replace the example.edu values; keep the
# install's deployment profile next to it (docs/deployments/README.md).
#
# No secrets: combine with your own .env or Kubernetes Secret (DATABASE_URL,
# ENCRYPTION_KEY, API_KEY_PEPPER, OIDC_*). Values are quoted for shells
# (`set -a && . ./example.env`); drop the quotes for tools that read them
# literally, such as `docker run --env-file`.

INSTANCE_NAME="Campus Assistant"
ORG_NAME="Example University"
UI_THEME=neutral
# UI_LOGO_URL=https://www.example.edu/logo.svg
# SUPPORT_URL=https://help.example.edu/ai

# Added to the crawl allowlist once, on the first start.
CRAWL_ALLOWLIST_SEED=*.example.edu

# Single sign-on through the institution's identity provider.
# OIDC_ISSUER=https://login.example.edu
# OIDC_CLIENT_ID=grounded
# OIDC_ALLOWED_EMAIL_DOMAINS=example.edu
# TEAM_REQUEST_URL=https://help.example.edu/new-team
