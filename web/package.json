{
  "name": "grounded-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build -c vite.widget.config.ts",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:styling": "node scripts/check-styling.mjs",
    "check:size": "node scripts/check-size.mjs",
    "ui:check": "bitop diff --check",
    "typecheck": "tsc --noEmit && tsc -p e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "lucide-react": "1.48.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@bitop-dev/cli": "0.1.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vitest-axe": "0.1.0"
  }
}
