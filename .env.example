# Local development. Copy to .env: `cp .env.example .env`, then `make run`.
# These values only work with a loopback APP_URL: Grounded refuses to start
# on any other APP_URL with the example ENCRYPTION_KEY or API_KEY_PEPPER below,
# with DEV_AUTH=true, or with an http:// APP_URL. `grounded doctor` checks the
# configuration and every dependency.
APP_URL=http://localhost:8080
HTTP_ADDR=127.0.0.1:8080
WORKER_HTTP_ADDR=127.0.0.1:9090
# Serve the api's /metrics on this internal listener instead of HTTP_ADDR,
# so a public ingress never exposes it (Kubernetes base: :9091).
# METRICS_ADDR=
DATABASE_URL=postgres://grounded:grounded-dev-only@127.0.0.1:55432/grounded?sslmode=disable
VALKEY_URL=redis://127.0.0.1:56379/0
MIGRATE_ON_START=true

# Encrypts secrets stored in the database (model proxy API keys).
# Development-only value, refused off loopback; generate your own with:
# openssl rand -base64 32
ENCRYPTION_KEY=dhi4PJ88URUmYkB0gc7BGWkWI2KrYJBM5bdj7IfEfTo=
# Rotation (docs/operations/rotate-keys.md): the old key, still accepted for
# reads until `grounded rotate-keys` has re-encrypted everything.
# ENCRYPTION_KEY_PREVIOUS=

# Keys the HMAC of stored API key hashes. Changing it without keeping the old
# value as API_KEY_PEPPER_PREVIOUS invalidates all API keys.
# Development-only value, refused off loopback; generate your own with:
# openssl rand -base64 32
API_KEY_PEPPER=FKaLRuR10brhXmbFfmm+9j92BGr82C9qu2OYaBxwfic=
# API_KEY_PEPPER_PREVIOUS=

# Object storage: fs (single node, default) or s3 (see S3_* settings).
BLOB_BACKEND=fs
BLOB_DIR=data/blobs
# BLOB_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:59000   # docker compose --profile s3 up -d
# S3_BUCKET=grounded
# S3_ACCESS_KEY=grounded
# S3_SECRET_KEY=grounded-dev-only-secret
LOG_FORMAT=text
LOG_LEVEL=debug
SHUTDOWN_DELAY=0s

# Local-only login with fixed personas. Refused unless APP_URL is loopback.
DEV_AUTH=true
# Fake identity-provider groups for the personas, to try SSO group mapping
# (docs/operations/sso-groups.md): persona=group,group;persona=group
# DEV_AUTH_GROUPS=alex=registrar-staff;blair=registrar-staff,library-staff

# Instance identity (ADR-0018). Nothing in the product names an institution;
# each deployment sets its own. deploy/examples/example.env is a template.
# INSTANCE_NAME=Grounded          # product name in the UI and page titles (quote values with spaces)
# ORG_NAME=                       # e.g. "Example University"; used in the agent preamble
# UI_THEME=neutral                # neutral (the only theme; brand with the settings above and below)
# UI_LOGO_URL=                    # https URL or same-origin path, e.g. https://www.example.edu/logo.svg
# SUPPORT_URL=                    # "Help" link: http(s) URL or mailto: address

# Optional Apache Tika fallback for document parsing. Built-in parsers handle
# PDF, DOCX, PPTX, HTML, Markdown and text without it.
# docker compose --profile tika up -d
# TIKA_URL=http://127.0.0.1:59998
# TIKA_PREFER_KINDS=          # e.g. pdf to try Tika before the built-in parser

# OCR for scanned PDF pages and image uploads (docs/operations/ocr.md). Off
# until a platform admin turns it on in Admin -> Parsing; only configured
# backends can be chosen there (TIKA_URL makes Tika one; a vision model needs
# no setting here).
# With OCR_TESSERACT_URL set, `make deps-up` starts the sidecar (or: docker compose --profile ocr up -d --build ocr).
# OCR_TESSERACT_URL=http://127.0.0.1:58080   # the grounded-ocr sidecar
# OCR_TIMEOUT=2m                             # one page's OCR request
# OCR_MAX_PAGES_PER_DOCUMENT=200             # pages beyond it are skipped with a warning
# OCR_CONCURRENCY=2                          # pages read at once per worker process

# Ingestion and retrieval tuning (defaults shown). See docs/benchmarks/scale-10k.md.
# INGEST_CONCURRENCY=4             # document jobs per worker process
# INGEST_MAX_INFLIGHT_PER_TEAM=8    # default concurrent_ingest_jobs team limit
# EMBED_BATCH_SIZE=64               # inputs per embedding request, shared across documents
# EMBED_BATCH_TOKENS=32768          # counted tokens per embedding request (0 = no limit)
# EMBED_BATCH_WAIT=100ms            # how long a partial request waits for more documents
# VECTOR_EXACT_THRESHOLD=100000     # KBs with up to this many vectors are searched exactly
# VECTOR_EF_SEARCH=400              # HNSW candidate list above the threshold
# RETRIEVAL_VECTOR_WEIGHT=1         # hybrid fusion weights (0-1); KBs may override them
# RETRIEVAL_KEYWORD_WEIGHT=0.1
# PROFILE_MIGRATION_GRACE_DAYS=7    # days a KB keeps its old vectors after a profile migration (switch back)
# EVALUATION_CONCURRENCY=2          # questions an evaluation run checks at once (1-8)
# HEALTH_CHECK_INTERVAL=15m         # how often enabled connections and models are re-tested (5m-24h; 0 or off: never)

# Repeated-boilerplate suppression (ADR-0021): blocks (navigation, footers,
# "related content" cards) in at least max(MIN_DOCS, RATIO x documents) of a
# source's documents are left out of chunks, keeping one copy. Sources may
# override all four. See docs/benchmarks/boilerplate.md.
# BOILERPLATE_WEB=true              # on for web sources
# BOILERPLATE_UPLOAD=false          # off for upload sources (opt-in per source)
# BOILERPLATE_MIN_DOCS=5            # 2-100000
# BOILERPLATE_RATIO=0.2             # 0.05-1

# Moderation (ADR-0019): providers and policies are set in the admin UI.
# MODERATION_TIMEOUT=10s            # bounds each moderation check attempt (1s-2m), besides the connection timeout; models may set their own, chat classifiers get at least 30s

# Web crawling (web data sources). SSRF protection is always on: private,
# loopback and link-local addresses and ports other than 80/443 are refused.
# CRAWL_MAX_PAGES=10000          # ceiling for a source's maxPages
# CRAWL_ORIGIN_INTERVAL=1s       # spacing between requests to one site, across all workers (100ms-1m)
# CRAWL_USER_AGENT=              # default: grounded/1.0 (+$APP_URL/bot)
# CRAWL_TIMEOUT=30s              # per request, including the body
# CRAWL_MAX_BODY_BYTES=20971520  # larger pages are skipped
# CRAWL_CONCURRENCY=4            # crawl jobs per worker process (River queue "web")
# The allowlist starts empty, so nothing can be crawled until a platform admin
# adds host patterns. CRAWL_ALLOWLIST_SEED adds patterns once, on the first
# start (deleting them later does not bring them back).
# An empty allowlist is reported as a warning at startup and on the admin Overview.
# CRAWL_ALLOWLIST_SEED=*.example.edu,example.org

# Where people request a team (for example a service desk request form).
# TEAM_REQUEST_URL=https://help.example.edu/new-team

# Notification email over SMTP (invites, sync failures, ...). Email is off
# while SMTP_HOST is empty; in-app notifications always work. For local
# development, run Mailpit (docker compose --profile mail up -d mailpit;
# inbox at http://127.0.0.1:8025) with SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_TLS=none.
# Without SMTP_HOST, Grounded warns at startup and on the admin Overview.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587                  # 587 for starttls, 465 for tls
# SMTP_TLS=starttls              # starttls | tls | none (none: local relay only)
# SMTP_USERNAME=
# SMTP_PASSWORD=                 # or SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# SMTP_FROM="Grounded <rag@example.edu>"

# Public agents and the widget (a platform admin turns public access on in
# Administration > Public access). Anonymous sessions end this long after
# their last use; CAPTCHA runs when a visitor starts a session.
# ANON_SESSION_TTL=24h
# CAPTCHA_PROVIDER=none          # none | turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=          # or TURNSTILE_SECRET_KEY_FILE=/run/secrets/turnstile

# Retention defaults (docs/operations/retention.md). Empty or "keep" keeps
# the data: nothing is deleted until a period is set. Confirm periods with
# your records management first. A platform admin can override each one in
# Administration > Retention; conversation retention is set per
# classification level. Legal holds keep what they cover regardless.
# RETENTION_DELETED_CONVERSATIONS_DAYS=   # grace after a user deletes a conversation (0-36500)
# RETENTION_ACCESS_LOG_DAYS=              # 1-36500
# RETENTION_ANALYTICS_EVENTS_DAYS=        # per-answer metadata events, 1-36500
# RETENTION_USAGE_EVENTS_DAYS=            # usage ledger, rolled up per day first, 7-36500
# RETENTION_AUDIT_LOG_DAYS=               # 30-36500; legal hold entries are always kept
# RETENTION_DELETED_FILES_DAYS=           # stored files of deleted documents and sources, 0-36500
# RETENTION_EXPIRED_INVITES_DAYS=         # after an invite expires or is revoked, 1-36500
# RETENTION_EVALUATION_RUNS_DAYS=180      # evaluation runs and their results, 1-36500 or keep
# RETENTION_BATCH_SIZE=500                # rows per transaction
# RETENTION_MAX_BATCHES=100               # batches per kind per run (every 10 minutes)

# Real single sign-on (any OIDC provider). Leave OIDC_ISSUER empty to disable.
# OIDC_ISSUER=https://idp.example.edu
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid,profile,email
# OIDC_EMAIL_CLAIM=email
# OIDC_GROUPS_CLAIM=groups                 # the IdP groups for SSO group mapping (Authentik: with the profile scope)
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# OIDC_ALLOWED_EMAIL_DOMAINS=example.edu   # empty: anyone the provider signs in (reported as information)
# BOOTSTRAP_ADMIN_SUBJECT=
