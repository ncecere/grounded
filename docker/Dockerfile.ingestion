FROM oven/bun:1
WORKDIR /app

ARG VERSION=dev
ENV APP_VERSION=$VERSION

# Copy everything at once for workspace resolution
COPY package.json bun.lockb* ./
COPY packages ./packages
COPY apps/ingestion-worker ./apps/ingestion-worker

# Install dependencies after source is available
RUN bun install || true

# Create non-root user (GID/UID 1000 may already exist in base image)
RUN getent group 1000 || groupadd -g 1000 appuser && \
    getent passwd 1000 || useradd -u 1000 -g 1000 -m appuser
RUN chown -R 1000:1000 /app
USER 1000

ENV NODE_ENV=production
CMD ["bun", "run", "apps/ingestion-worker/src/index.ts"]
